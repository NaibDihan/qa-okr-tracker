# Copy this file to ".env" and fill in your values.
# If JIRA_BASE_URL, JIRA_EMAIL or JIRA_API_TOKEN is empty, the app runs in
# DEMO mode and generates sample Jira numbers so you can try it out.

PORT=3000

# Jira Cloud
JIRA_BASE_URL=https://asthait.atlassian.net
JIRA_EMAIL=
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Exact names in your Jira workflow (apostrophe style doesn't matter)
JIRA_BUG_TYPE=Bug
JIRA_STATUS_REJECTED=Won’t Do
JIRA_STATUS_IN_QA=In QA
JIRA_STATUS_CLOSED=Closed

# How long Jira results are cached in memory, in minutes (the Refresh button bypasses it)
JIRA_CACHE_MINUTES=10
