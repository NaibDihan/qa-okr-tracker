# Copy this file to ".env" and fill in your values.
# If JIRA_BASE_URL, JIRA_EMAIL or JIRA_API_TOKEN is empty, the app runs in
# DEMO mode and generates sample Jira numbers so you can try it out.

PORT=3000

# Jira Cloud. For several Jira sites, separate them with commas; the first is the default.
# One Atlassian account (email + API token) is used for all sites it can open.
JIRA_BASE_URL=https://asthait.atlassian.net,https://emctech.atlassian.net
JIRA_EMAIL=
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# A site that needs a different login: add its own token (and email, if different),
# named after the first word of its address. Other sites keep using the two lines above.
# JIRA_API_TOKEN_CABOODLESERVICES=
# JIRA_EMAIL_CABOODLESERVICES=

# Exact names in your Jira workflow (apostrophe style doesn't matter)
JIRA_BUG_TYPE=Bug
JIRA_STATUS_REJECTED=Won’t Do
JIRA_STATUS_IN_QA=In QA
JIRA_STATUS_CLOSED=Closed

# Time zone used to decide which day/month a Jira status change falls in (default Asia/Dhaka)
APP_TIMEZONE=Asia/Dhaka

# How long Jira results are cached in memory, in minutes (the Refresh button bypasses it)
JIRA_CACHE_MINUTES=10

# ---------- Bitbucket (optional) ----------
# Fills "Automated Test Scripts Added" and "PR Merged (Automation)" automatically from
# pull requests merged into BITBUCKET_BRANCH. Values can still be edited on Monthly Entry.
# Leave empty to keep both KRs manual.
# Token: Atlassian account → Security → "Create API token with scopes" → app: Bitbucket →
# scopes read:repository:bitbucket and read:pullrequest:bitbucket.
BITBUCKET_REPOS=asthait/playwright_automation
BITBUCKET_BRANCH=main
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=

# ---------- Optional ----------

# Team password. When set, everyone must enter it once per browser (remembered 30 days).
# Strongly recommended on a public host like Vercel. Leave empty to turn it off.
APP_PASSWORD=

# Cloud database (Upstash Redis). Vercel adds these automatically when you connect
# an Upstash database to the project. Only put them here locally if you want to
# run `npm run upload-data` to copy your local data to the cloud.
KV_REST_API_URL=
KV_REST_API_TOKEN=
